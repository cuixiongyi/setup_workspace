--- a/.tmux.conf
+++ b/.tmux.conf
@@ -6,24 +6,6 @@
 # /!\ do not edit this file
 #     instead, override settings in ~/.tmux.conf.local, see README.md
 
-# natural scrolling, mouse + big scrollback
-set -g mouse on
-set -g history-limit 100000
-setw -g mode-keys vi
-
-# ---- Stay in copy-mode after mouse selection (drag, double-click, triple-click) ----
-# Drag select: copy, but DON'T exit copy-mode
-bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-selection-no-clear
-bind-key -T copy-mode    MouseDragEnd1Pane send-keys -X copy-selection-no-clear
-
-# Double click: select word + copy, but DON'T exit copy-mode
-bind-key -T copy-mode-vi DoubleClick1Pane send-keys -X select-word \; send-keys -X copy-selection-no-clear
-bind-key -T copy-mode    DoubleClick1Pane send-keys -X select-word \; send-keys -X copy-selection-no-clear
-
-# Triple click: select line + copy, but DON'T exit copy-mode
-bind-key -T copy-mode-vi TripleClick1Pane send-keys -X select-line \; send-keys -X copy-selection-no-clear
-bind-key -T copy-mode    TripleClick1Pane send-keys -X select-line \; send-keys -X copy-selection-no-clear
-
 # -- general -------------------------------------------------------------------
 
 set -g default-terminal "screen-256color" # colors!
