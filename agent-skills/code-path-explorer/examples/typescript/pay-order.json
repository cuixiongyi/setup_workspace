{
  "$schema": "../../scripts/journey.schema.json",
  "format": "journey-explorer/2",
  "title": "Pay for an order · TypeScript example",
  "lead": "A customer pays for an order. The server starts a payment intent, the browser confirms the card with the provider, and a signed webhook marks the order paid. A scheduled job expires orders nobody paid for. Opens at `Component / schema`.",
  "note": "A self-contained example: the cited files are under examples/typescript. Build with --root examples/typescript. Payloads are synthetic.",
  "export": "pay-order.json",
  "outside": [
    "Building the cart, shipping, and the provider’s own retries and intent expiry."
  ],
