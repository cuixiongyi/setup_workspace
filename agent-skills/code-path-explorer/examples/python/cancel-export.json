      "transaction": "tx-cancel"
    },
    {
      "id": "i-end-queued",
      "scenarios": [
        "cancel-queued"
      ],
      "phase": "Cancel",
      "from": "fn-repo-cancel",
      "to": "tbl-job",
      "title": "End it cancelled",
      "delivery": "delivered",
      "boundary": "database-call",
      "summary": "Queued: nothing has started, so it ends at once.",
      "evidence": "app/db/exports_repo.py ExportRepository.cancel",
      "mechanism": "UPDATE exports.export_job SET state = 'cancelled', cancel_reason = 'not_started', finished_at = now()",
      "transition": "t-cancel-queued",
      "checkpoint": "cp-not-started",
      "transaction": "tx-cancel"
    },
    {
      "id": "i-request-stop",
      "scenarios": [
