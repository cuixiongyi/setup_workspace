        "cancel-running"
      ],
      "phase": "Claim",
      "from": "fn-claim",
      "to": "tbl-job",
      "title": "UPDATE … SKIP LOCKED",
      "delivery": "delivered",
      "boundary": "database-call",
      "summary": "One statement claims a row no other worker holds.",
      "evidence": "app/db/exports_repo.py ExportRepository.claim_next",
      "mechanism": "UPDATE exports.export_job SET state = 'running', worker_id = $1 WHERE id = (SELECT … FOR UPDATE SKIP LOCKED LIMIT 1) RETURNING *",
