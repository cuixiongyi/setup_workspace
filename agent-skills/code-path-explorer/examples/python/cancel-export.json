    {
      "id": "i-lock",
      "scenarios": [
        "cancel-queued",
        "cancel-running"
      ],
      "phase": "Cancel",
      "from": "fn-repo-cancel",
      "to": "tbl-job",
      "title": "BEGIN; lock the row",
      "delivery": "delivered",
      "boundary": "database-call",
      "summary": "The claim and the worker’s finish wait on this lock.",
