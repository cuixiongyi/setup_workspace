    {
      "id": "i-service",
      "scenarios": [
        "cancel-queued",
        "cancel-running"
      ],
      "phase": "Check",
      "from": "fn-route",
      "to": "fn-svc-cancel",
      "title": "Cancel in the service",
      "delivery": "delivered",
      "boundary": "call",
      "summary": "The route passes the export id and the signed-in user.",
