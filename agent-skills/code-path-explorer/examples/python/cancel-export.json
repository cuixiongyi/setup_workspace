      ],
      "phase": "Cancel",
      "from": "fn-repo-cancel",
      "to": "tbl-job",
      "title": "Record a stop request",
      "delivery": "delivered",
      "boundary": "database-call",
      "summary": "Running: the worker owns the upload, so the API only asks it to stop.",
