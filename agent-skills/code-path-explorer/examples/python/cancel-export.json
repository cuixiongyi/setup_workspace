    {
      "id": "i-repo",
      "scenarios": [
        "cancel-queued",
        "cancel-running"
      ],
      "phase": "Check",
      "from": "fn-svc-cancel",
      "to": "fn-repo-cancel",
      "title": "Ask the repository to cancel",
