      "phase": "Claim",
      "from": "trg-event",
      "to": "tbl-event",
      "title": "INSERT queued → running",
      "delivery": "delivered",
      "boundary": "database-trigger",
      "summary": "One event row per state change.",
      "evidence": "db/schema.sql exports.record_export_event"
    },
    {
      "id": "i-run",
      "scenarios": [
        "cancel-running"
